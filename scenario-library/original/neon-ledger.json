{
  "scenario": {
    "id": "cpred-original-neon-ledger",
    "title": "ネオンの帳簿（オリジナル・分岐シナリオ）",
    "summary": "失踪した配送員の救出と不正データの処遇を巡る、交渉・潜入・戦闘の選択型オリジナル短編。原作掲載シナリオの翻案ではありません。",
    "meta": {
      "players_min": 2,
      "players_max": 5,
      "hours": 3,
      "tags": [
        "オリジナル",
        "分岐",
        "調査",
        "潜入"
      ],
      "shop_ids": [],
      "reward_note": "報酬・IPはGM判断。公式数値を推測していない。"
    },
    "version": 1,
    "created_at": 1792740000000,
    "updated_at": 1792740000000
  },
  "scenes": [
    {
      "id": "cpred-original-neon-ledger-start",
      "scenario_id": "cpred-original-neon-ledger",
      "title": "消えた配送員",
      "read_aloud": "夜の小雨に濡れた路地。修理屋ミカが古い配送端末を差し出す。「運び屋のレンが帰ってこない。端末の最後の信号は旧貨物駅から出ている」",
      "gm_notes": "依頼人ミカ：応急修理屋。レンを探してほしい。報酬はGMがキャンペーン経済に合わせて決める。情報を断っても旧貨物駅へ向かえる。",
      "location": "ミカの工房",
      "npc_ids": [],
      "position": {
        "x": 100,
        "y": 120
      },
      "sort_index": 0,
      "is_adhoc": false,
      "stage": {
        "portraits": []
      },
      "bgm": null
    },
    {
      "id": "cpred-original-neon-ledger-station",
      "scenario_id": "cpred-original-neon-ledger",
      "title": "旧貨物駅の調査",
      "read_aloud": "貨物駅には壊れた監視カメラと新しいタイヤ痕が残っている。閉鎖ゲートの先から発電機の音が聞こえる。",
      "gm_notes": "知覚・電子セキュリティなどの判定を提示。失敗しても進行を止めない。監視カメラの映像から敵の存在を把握する。",
      "location": "旧貨物駅",
      "npc_ids": [],
      "position": {
        "x": 370,
        "y": 120
      },
      "sort_index": 1,
      "is_adhoc": false,
      "stage": {
        "portraits": []
      },
      "bgm": null
    },
    {
      "id": "cpred-original-neon-ledger-contact",
      "scenario_id": "cpred-original-neon-ledger",
      "title": "警備員との交渉",
      "read_aloud": "警備員のカイは手を上げた。「あんたら、レンを探しているのか？　俺もこの仕事から抜けたい」",
      "gm_notes": "カイ：借金を抱える施設警備員。交渉に成功すれば地下搬入口を教える。敵対すると戦闘に発展し得る。",
      "location": "旧貨物駅・警備室",
      "npc_ids": [],
      "position": {
        "x": 640,
        "y": 120
      },
      "sort_index": 2,
      "is_adhoc": false,
      "stage": {
        "portraits": []
      },
      "bgm": null
    },
    {
      "id": "cpred-original-neon-ledger-sneak",
      "scenario_id": "cpred-original-neon-ledger",
      "title": "地下搬入口",
      "read_aloud": "地下への鉄扉には簡易ロックがある。奥から複数人の声が聞こえる。",
      "gm_notes": "ロック解除や忍び足で進める。失敗時は敵の警戒が上がり、次のシーンで不利な状況をGMが演出する。",
      "location": "地下搬入口",
      "npc_ids": [],
      "position": {
        "x": 910,
        "y": 120
      },
      "sort_index": 3,
      "is_adhoc": false,
      "stage": {
        "portraits": []
      },
      "bgm": null
    },
    {
      "id": "cpred-original-neon-ledger-fight",
      "scenario_id": "cpred-original-neon-ledger",
      "title": "倉庫の対峙",
      "read_aloud": "倉庫には拘束されたレンと、黒い運搬ケースを守る武装集団がいた。リーダーが言う。「ケースを置いて帰れ」",
      "gm_notes": "リーダーのヴェイル：密輸組織の現場責任者。戦闘か交渉か逃走かを選べる。敵データはシナリオ専用未設定。GMが既存NPCテンプレートを割り当てる。",
      "location": "地下倉庫",
      "npc_ids": [],
      "position": {
        "x": 1180,
        "y": 120
      },
      "sort_index": 4,
      "is_adhoc": false,
      "stage": {
        "portraits": []
      },
      "bgm": null
    },
    {
      "id": "cpred-original-neon-ledger-rescue",
      "scenario_id": "cpred-original-neon-ledger",
      "title": "レンの救出",
      "read_aloud": "レンの拘束具が外れる。彼は震えながら告げる。「ケースには個人情報の不正取引記録が入っている」",
      "gm_notes": "レン：配送員。裏切りではなく巻き込まれた被害者。次に情報の処遇を決める。",
      "location": "地下倉庫",
      "npc_ids": [],
      "position": {
        "x": 100,
        "y": 420
      },
      "sort_index": 5,
      "is_adhoc": false,
      "stage": {
        "portraits": []
      },
      "bgm": null
    },
    {
      "id": "cpred-original-neon-ledger-choice",
      "scenario_id": "cpred-original-neon-ledger",
      "title": "記録の行方",
      "read_aloud": "ケースの記録には不正な債権取引が残っている。レンは「公開すれば誰かが救われる。でも追手が来る」と言った。",
      "gm_notes": "公開・依頼人への引渡し・破棄の三択。全員が納得できる結末でなくてもよい。",
      "location": "ミカの工房",
      "npc_ids": [],
      "position": {
        "x": 370,
        "y": 420
      },
      "sort_index": 6,
      "is_adhoc": false,
